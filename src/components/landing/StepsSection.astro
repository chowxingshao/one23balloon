---
import type { LandingData } from '../../lib/landing/content.ts';
interface Props {
  steps: LandingData['steps'];
}
const { steps } = Astro.props;
---

<section class="steps band" aria-labelledby="steps-title">
  <div class="shell">
    <h2 id="steps-title" data-reveal>
      {steps.title}
    </h2>
    <ol class="step-list">
      {steps.items.map((step) => (
        <li data-reveal>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
